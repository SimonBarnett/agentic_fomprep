<?xml version="1.0" encoding="UTF-8"?>
<!--
  Priority Agent per-machine MSI (priority-mcp#566 / FR-001).
  Files harvested by heat.exe into HarvestedFiles.wxs (ComponentGroup PriorityAgentFiles).
  FR-001: no CLI dialog and no CLI custom action (FR-002/003 own those).
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
      Id="*"
      Name="Priority Agent"
      Language="1033"
      Version="$(var.ProductVersion)"
      Manufacturer="SimonBarnett"
      UpgradeCode="8F3A2C1E-9B4D-4E7A-9F12-5660A6E11786">
    <Package
        InstallerVersion="500"
        Compressed="yes"
        InstallScope="perMachine"
        Description="Priority Agent launcher"
        Comments="Installs PriorityAgent.exe under Program Files."
        Platform="x64" />

    <MajorUpgrade
        DowngradeErrorMessage="A newer version of Priority Agent is already installed."
        Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Feature Id="MainFeature" Title="Priority Agent" Level="1">
      <ComponentGroupRef Id="PriorityAgentFiles" />
      <ComponentRef Id="CmpInstallDirMark" />
      <ComponentRef Id="CmpStartMenuShortcut" />
      <ComponentRef Id="CmpDesktopShortcut" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="Priority Agent" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Priority Agent" />
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <Component Id="CmpInstallDirMark" Directory="INSTALLDIR" Guid="A11E5660-0A6E-4F01-9B12-005660A6E101" Win64="yes">
      <CreateFolder />
      <RegistryValue
          Root="HKLM"
          Key="Software\SimonBarnett\PriorityAgent"
          Name="InstallDir"
          Type="string"
          Value="[INSTALLDIR]"
          KeyPath="yes" />
    </Component>

    <!-- HKCU KeyPath satisfies ICE38/43 for non-advertised shortcuts (per-machine InstallScope). -->
    <Component Id="CmpStartMenuShortcut" Directory="ApplicationProgramsFolder" Guid="A11E5660-0A6E-4F01-9B12-005660A6E102" Win64="yes">
      <Shortcut
          Id="StartMenuShortcut"
          Name="Priority Agent"
          Description="Priority Agent launcher"
          Target="[INSTALLDIR]PriorityAgent.exe"
          WorkingDirectory="INSTALLDIR" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
      <RegistryValue
          Root="HKCU"
          Key="Software\SimonBarnett\PriorityAgent"
          Name="StartMenuShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>

    <Component Id="CmpDesktopShortcut" Directory="DesktopFolder" Guid="A11E5660-0A6E-4F01-9B12-005660A6E103" Win64="yes">
      <Shortcut
          Id="DesktopShortcut"
          Name="Priority Agent"
          Description="Priority Agent launcher"
          Target="[INSTALLDIR]PriorityAgent.exe"
          WorkingDirectory="INSTALLDIR" />
      <RegistryValue
          Root="HKCU"
          Key="Software\SimonBarnett\PriorityAgent"
          Name="DesktopShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>
  </Product>
</Wix>
